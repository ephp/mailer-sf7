{% extends 'email/base.html.twig' %}

{% block email_body %}
{% set heroImage = campaign.composition ? (campaign.composition['heroImage'] ?? null) : null %}
{% set ctaLabel = campaign.composition ? (campaign.composition['ctaLabel'] ?? 'Scopri di più') : 'Scopri di più' %}
{% set ctaUrl = campaign.composition ? (campaign.composition['ctaUrl'] ?? '#') : '#' %}

{% if heroImage %}
  <div style="margin:-32px -32px 24px;text-align:center;">
    <img src="{{ heroImage }}" alt="" style="width:100%;max-width:600px;display:block;">
  </div>
{% else %}
  <div style="margin:-32px -32px 24px;background-color:{{ primaryColor }};padding:40px 32px;text-align:center;">
    <p style="color:{{ onPrimaryColor }};font-size:26px;font-weight:bold;margin:0;">{{ subject }}</p>
  </div>
{% endif %}

<div style="color:{{ textColor }};font-size:15px;line-height:1.6;margin-bottom:28px;">
  {{ body|raw }}
</div>

<div style="text-align:center;margin:28px 0;">
  <a href="{{ ctaUrl }}"
     style="display:inline-block;background-color:{{ primaryColor }};color:{{ onPrimaryColor }};font-size:16px;font-weight:bold;padding:14px 32px;border-radius:4px;text-decoration:none;">
    {{ ctaLabel }}
  </a>
</div>
{% endblock %}
