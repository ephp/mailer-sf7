<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ subject }}</title>
  <style>
    body { margin: 0; padding: 20px; background-color: #ffffff; font-family: 'Courier New', Courier, monospace; font-size: 14px; color: {{ textColor }}; line-height: 1.7; }
    .email-plain-container { max-width: 600px; margin: 0 auto; }
    .email-plain-header { border-bottom: 2px solid {{ textColor }}; padding-bottom: 12px; margin-bottom: 20px; }
    .email-plain-from { font-weight: bold; }
    .email-plain-subject { font-style: italic; }
    .email-plain-body { white-space: pre-wrap; word-wrap: break-word; }
    .email-plain-footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #cccccc; font-size: 12px; color: #666666; }
    a { color: {{ textColor }}; text-decoration: underline; }
    @media only screen and (max-width: 600px) {
      body { padding: 12px; }
    }
  </style>
</head>
<body>
  <div class="email-plain-container">
    <div class="email-plain-header">
      <div class="email-plain-from">Da: {{ account.ragioneSociale }}</div>
      <div class="email-plain-subject">Oggetto: {{ subject }}</div>
    </div>
    <div class="email-plain-body">{{ body|striptags }}</div>
    <div class="email-plain-footer">
      <div>{{ account.ragioneSociale }}</div>
      {% if unsubscribeUrl %}
        <div>Per disiscriverti: {{ unsubscribeUrl }}</div>
      {% endif %}
    </div>
  </div>
</body>
</html>
